PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_to_a_very_long_random_string_at_least_64_chars_xxxxxxxxxxxxxx
JWT_REFRESH_SECRET=another_very_long_random_string_for_refresh_tokens_yyyyyyyyyyyyyy
JWT_EXPIRES=1h
JWT_REFRESH_EXPIRES=30d

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=experthub

# Optional SMTP for password reset emails (falls back to console logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@experthub.local

# Platform
PLATFORM_COMMISSION=20
WITHDRAWAL_HOLD_DAYS=7
MIN_PAYOUT=50
